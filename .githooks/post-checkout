#!/usr/bin/env sh
set -eu

OLD_REF="${1:-}"
NEW_REF="${2:-}"
BRANCH_SWITCH="${3:-0}"

# Run only when HEAD moved due to branch checkout
if [ "$BRANCH_SWITCH" != "1" ]; then
  exit 0
fi

if [ "$OLD_REF" = "$NEW_REF" ]; then
  exit 0
fi

echo "[post-checkout] Syncing Wails bindings with pinned CLI v2.12.0..."

if command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -File scripts/wails.ps1 build -skipfrontend >/dev/null
elif command -v powershell >/dev/null 2>&1; then
  powershell -NoProfile -File scripts/wails.ps1 build -skipfrontend >/dev/null
else
  go run github.com/wailsapp/wails/v2/cmd/wails@v2.12.0 build -skipfrontend >/dev/null
fi

echo "[post-checkout] Wails binding sync done."
